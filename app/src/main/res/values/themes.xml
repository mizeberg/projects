<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.JohnAI" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/obsidian</item>
    </style>

    <!-- Cinematic but short: obsidian ground, ambient purple, no startup delay. -->
    <style name="Theme.JohnAI.Splash" parent="Theme.JohnAI">
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/obsidian</item>
    </style>
</resources>
