server/node_modules/
server/data/

# Build outputs (produced by tools/build-apk.sh)
dist/*
# ...except the testing package, which is committed so it can be downloaded
# directly without a build environment. Signing keys, the R8 mapping file and
# the other build variants stay out of the repository.
!dist/john-ai.apk
!dist/JOHN_AI_TESTING.zip
